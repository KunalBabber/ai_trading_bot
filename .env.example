# ==============================================================================
# XRP AI TRADING AGENT - CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env before running: cp .env.example .env
# - DO NOT commit .env or any file containing real API keys to version control.
# - Phase 1 operates in READ-ONLY / PAPER-TRADING mode only.
# ==============================================================================

# Exchange Configuration
# Base URLs:
#   Global Production: https://api.delta.exchange
#   Global Testnet:    https://testnet-api.delta.exchange
#   India Production:  https://cdn.india.delta.exchange (or https://api.india.delta.exchange)
DELTA_BASE_URL=https://api.delta.exchange
DELTA_WS_URL=wss://socket.delta.exchange

# Delta Exchange API Credentials
# Leave empty for unauthenticated public market data requests.
# For account / balance queries in read-only mode, provide your Delta API key and secret.
DELTA_API_KEY=
DELTA_API_SECRET=

# Asset & Contract Configuration
# Supported XRP symbols on Delta Exchange: XRPUSDT, XRP_USDT (or other contract symbols)
DELTA_SYMBOL=XRPUSDT

# Trading Strategy Timeframe
# Supported: 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 1d
TIMEFRAME=5m

# Safety & Execution Mode
# In Phase 1, PAPER_TRADING is strictly enforced to true.
# LIVE_TRADING_ENABLED is hard-locked to false in Phase 1 infrastructure.
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false

# Database Configuration
DB_PATH=data/trading_agent.db

# Structured Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/trading_agent.log

# API Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
